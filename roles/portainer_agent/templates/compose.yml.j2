services:
  portainer-agent:
    image: portainer/agent:lts
    container_name: portainer-agent
    restart: unless-stopped
{% if portainer_agent_secret is defined and portainer_agent_secret | length > 0 %}
    environment:
      AGENT_SECRET: {{ portainer_agent_secret | to_json }}
{% endif %}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
    networks:
      - proxy

networks:
  proxy:
    external: true
    name: proxy
