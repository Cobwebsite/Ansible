# yaml-language-server: $schema=https://goauthentik.io/blueprints/schema.json
version: 1
metadata:
  name: Applications SSO du serveur master
entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: portainer-provider
    state: present
    identifiers:
      name: Portainer
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      grant_types:
        - authorization_code
        - refresh_token
      include_claims_in_id_token: true
      client_id: !Env PORTAINER_OIDC_CLIENT_ID
      client_secret: !Env PORTAINER_OIDC_CLIENT_SECRET
      redirect_uris:
        - matching_mode: strict
          url: "https://{{ portainer_domain }}/"
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]

  - model: authentik_core.application
    state: present
    identifiers:
      slug: portainer
    attrs:
      name: Portainer
      provider: !KeyOf portainer-provider
      meta_launch_url: "https://{{ portainer_domain }}/"
      policy_engine_mode: any

  - model: authentik_providers_proxy.proxyprovider
    id: beszel-provider
    state: present
    identifiers:
      name: Beszel
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      mode: forward_single
      external_host: "https://{{ beszel_domain }}"

  - model: authentik_core.application
    state: present
    identifiers:
      slug: beszel
    attrs:
      name: Beszel
      provider: !KeyOf beszel-provider
      meta_launch_url: "https://{{ beszel_domain }}/"
      policy_engine_mode: any

  - model: authentik_providers_proxy.proxyprovider
    id: uptime-kuma-provider
    state: present
    identifiers:
      name: Uptime Kuma
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      mode: forward_single
      external_host: "https://{{ uptime_kuma_domain }}"

  - model: authentik_core.application
    state: present
    identifiers:
      slug: uptime-kuma
    attrs:
      name: Uptime Kuma
      provider: !KeyOf uptime-kuma-provider
      meta_launch_url: "https://{{ uptime_kuma_domain }}/"
      policy_engine_mode: any

  - model: authentik_providers_oauth2.oauth2provider
    id: termix-provider
    state: present
    identifiers:
      name: Termix OIDC
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      grant_types:
        - authorization_code
        - refresh_token
      include_claims_in_id_token: true
      signing_key: !Find
        - authentik_crypto.certificatekeypair
        - [name, authentik Self-signed Certificate]
      client_id: !Env TERMIX_OIDC_CLIENT_ID
      client_secret: !Env TERMIX_OIDC_CLIENT_SECRET
      redirect_uris:
        - matching_mode: strict
          url: "https://{{ termix_domain }}/users/oidc/callback"
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]

  - model: authentik_core.application
    state: present
    identifiers:
      slug: termix
    attrs:
      name: Termix
      provider: !KeyOf termix-provider
      meta_launch_url: "https://{{ termix_domain }}/"
      policy_engine_mode: any

  - model: authentik_providers_oauth2.oauth2provider
    id: semaphore-provider
    state: present
    identifiers:
      name: Semaphore
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      grant_types:
        - authorization_code
        - refresh_token
      include_claims_in_id_token: true
      signing_key: !Find
        - authentik_crypto.certificatekeypair
        - [name, authentik Self-signed Certificate]
      client_id: !Env SEMAPHORE_OIDC_CLIENT_ID
      client_secret: !Env SEMAPHORE_OIDC_CLIENT_SECRET
      redirect_uris:
        - matching_mode: strict
          url: "https://{{ semaphore_domain }}/api/auth/oidc/authentik/redirect"
        - matching_mode: strict
          url: "https://{{ semaphore_domain }}/api/auth/oidc/authentik/redirect/"
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]

  - model: authentik_core.application
    state: present
    identifiers:
      slug: semaphore
    attrs:
      name: Semaphore
      provider: !KeyOf semaphore-provider
      meta_launch_url: "https://{{ semaphore_domain }}/"
      policy_engine_mode: any

  - model: authentik_providers_proxy.proxyprovider
    id: homepage-provider
    state: present
    identifiers:
      name: Homepage
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      mode: forward_single
      external_host: "https://{{ homepage_domain }}"

  - model: authentik_core.application
    state: present
    identifiers:
      slug: homepage
    attrs:
      name: Homepage
      provider: !KeyOf homepage-provider
      meta_launch_url: "https://{{ homepage_domain }}/"
      policy_engine_mode: any

  - model: authentik_outposts.outpost
    state: present
    identifiers:
      name: authentik Embedded Outpost
    attrs:
      config:
        authentik_host: "https://{{ authentik_domain }}/"
        authentik_host_browser: "https://{{ authentik_domain }}/"
      providers:
        - !KeyOf homepage-provider
        - !KeyOf beszel-provider
        - !KeyOf uptime-kuma-provider

  - model: authentik_core.group
    id: homelab-users
    state: present
    identifiers:
      name: homelab-users
    attrs:
      is_superuser: false

{% for app_slug in ['portainer', 'semaphore', 'homepage', 'beszel', 'uptime-kuma', 'termix'] %}
  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, {{ app_slug }}]]
      order: 0
    attrs:
      group: !KeyOf homelab-users
{% endfor %}

  - model: authentik_stages_identification.identificationstage
    state: present
    identifiers:
      name: default-authentication-identification
    attrs:
      user_fields:
        - username
        - email

  - model: authentik_stages_user_login.userloginstage
    state: present
    identifiers:
      name: default-authentication-login
    attrs:
      session_duration: days=30
      remember_me_offset: seconds=0
