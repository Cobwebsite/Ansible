# yaml-language-server: $schema=https://goauthentik.io/blueprints/schema.json
version: 1
metadata:
  name: Applications SSO du serveur master
entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: portainer-provider
    state: present
    identifiers:
      name: Portainer
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      include_claims_in_id_token: true
      client_id: "{{ portainer_oidc_client_id }}"
      client_secret: "{{ portainer_oidc_client_secret }}"
      redirect_uris:
        - matching_mode: strict
          url: "https://{{ portainer_domain }}/"
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]

  - model: authentik_core.application
    state: present
    identifiers:
      slug: portainer
    attrs:
      name: Portainer
      provider: !KeyOf portainer-provider
      meta_launch_url: "https://{{ portainer_domain }}/"
      policy_engine_mode: any

  - model: authentik_providers_oauth2.oauth2provider
    id: semaphore-provider
    state: present
    identifiers:
      name: Semaphore
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      include_claims_in_id_token: true
      client_id: "{{ semaphore_oidc_client_id }}"
      client_secret: "{{ semaphore_oidc_client_secret }}"
      redirect_uris:
        - matching_mode: strict
          url: "https://{{ semaphore_domain }}/api/auth/oidc/authentik/redirect"
        - matching_mode: strict
          url: "https://{{ semaphore_domain }}/api/auth/oidc/authentik/redirect/"
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]

  - model: authentik_core.application
    state: present
    identifiers:
      slug: semaphore
    attrs:
      name: Semaphore
      provider: !KeyOf semaphore-provider
      meta_launch_url: "https://{{ semaphore_domain }}/"
      policy_engine_mode: any

  - model: authentik_providers_proxy.proxyprovider
    id: homepage-provider
    state: present
    identifiers:
      name: Homepage
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      mode: forward_single
      external_host: "https://{{ homepage_domain }}"

  - model: authentik_core.application
    state: present
    identifiers:
      slug: homepage
    attrs:
      name: Homepage
      provider: !KeyOf homepage-provider
      meta_launch_url: "https://{{ homepage_domain }}/"
      policy_engine_mode: any

  - model: authentik_outposts.outpost
    state: present
    identifiers:
      name: authentik Embedded Outpost
    attrs:
      config:
        authentik_host: "https://{{ authentik_domain }}/"
        authentik_host_browser: "https://{{ authentik_domain }}/"
      providers:
        - !KeyOf homepage-provider
